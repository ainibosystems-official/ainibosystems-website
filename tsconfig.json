{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,       // ✅ added
    "moduleResolution": "node",
    "resolveJsonModule": true,                  // ✅ enables JSON imports
    "isolatedModules": true,
    "jsx": "preserve",

    "baseUrl": ".",                             // ✅ changed (was "src")
    "paths": {
      "@/*": ["src/*"]                          // ✅ fixed path mapping
    },

    "plugins": [
      { "name": "next" }
    ],
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "src/types/**/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
